<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 无 root 重启小黑盒：杀掉其后台进程（普通权限，自动授予） -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!--
      现代 API 102：不再使用 xposedmodule / xposedminversion meta-data。
      模块声明全部由 META-INF/xposed/ 下的文件提供：
        - module.prop     API 版本 / staticScope / autoHotReload
        - java_init.list  入口类
        - scope.list      作用域（staticScope=true 时生效）
      模块名称 = android:label，模块描述 = android:description。
    -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:description="@string/module_description"
        tools:ignore="MissingApplicationIcon">

        <!--
          桌面图标入口（可被「不显示桌面图标」开关禁用）。
          隐藏后仍可通过 小黑盒设置 → BetterHeybox 设置 进入模块设置。
        -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          模块设置界面。exported=true：允许小黑盒进程（Hook 注入的入口）启动它。
          不设 LAUNCHER：由 LaunchActivity 作为桌面入口（可被开关禁用）。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />
    </application>

</manifest>
