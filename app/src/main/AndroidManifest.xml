<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 无 root 重启小黑盒：杀掉其后台进程（普通权限，自动授予） -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Android 11+ package visibility for the standalone manager. -->
    <queries>
        <package android:name="com.max.xiaoheihe" />
        <package android:name="top.nkbe.npatch" />
        <package android:name="af.shizuku.plus.api" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!--
      现代 API 102：不再使用 xposedmodule / xposedminversion meta-data。
      模块声明全部由 META-INF/xposed/ 下的文件提供：
        - module.prop     API 版本 / staticScope / autoHotReload
        - java_init.list  入口类
        - scope.list      作用域（staticScope=true 时生效）
      模块名称 = android:label，模块描述 = android:description。
    -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:description="@string/module_description"
        tools:ignore="MissingApplicationIcon">

        <!--
          独立管理入口：不参与 Hook，只负责状态展示、快捷启动和 Rootless 引导。
          核心 Hook 仍由 LSPosed / NPatch 的 libxposed 环境提供。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PreferenceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.better.heybox.SET_BOOLEAN" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
